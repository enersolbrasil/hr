<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_ppe" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.hr.ppe</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='hr']" position="inside">
                <block title="Personal Protective Equipment (PPE)" name="ppe_setting_container">
                    <setting id="ppe_expiry_notice_setting" title="Expiry Notice" help="Days in advance to alert safety officer and employee before PPE expiration">
                        <field name="ppe_expiry_notice_days" class="oe_inline" />
                        <span class="ms-1">days in advance</span>
                    </setting>
                    <setting id="ppe_block_expired_ca_setting" title="Safety Certification (CA)" help="Block delivery of PPE with expired official safety certification">
                        <field name="ppe_block_expired_ca" />
                    </setting>
                    <setting id="ppe_signature_setting" title="Delivery Signature" help="Employee signature requirement and method for PPE delivery">
                        <div class="content-group">
                            <div class="d-flex">
                                <field name="ppe_require_signature" />
                                <label for="ppe_require_signature" class="ms-2" />
                            </div>
                            <div class="d-flex mt-2" invisible="not ppe_require_signature">
                                <label for="ppe_signature_method" class="me-2" />
                                <field name="ppe_signature_method" />
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
