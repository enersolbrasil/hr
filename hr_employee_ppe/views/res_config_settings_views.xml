<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form (in hr_employee_ppe)</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='hr']" position="inside">
                <block
                    title="Personal Protective Equipment"
                    name="ppe_setting_container"
                >
                    <setting
                        id="ppe_block_expired_certification_setting"
                        help="Do not deliver PPE whose certification has expired."
                    >
                        <field name="ppe_block_expired_certification" />
                    </setting>
                    <setting
                        id="ppe_require_signature_setting"
                        help="Validate the PPE only once the employee has signed their delivery."
                    >
                        <field name="ppe_require_signature" />
                    </setting>
                    <setting
                        id="ppe_expiry_notice_setting"
                        string="PPE Expiry Notice"
                        help="Schedule an activity to renew the delivered PPE before they expire."
                    >
                        <div class="content-group">
                            <div class="mt-2">
                                <field
                                    name="ppe_expiry_notice_days"
                                    class="oe_inline"
                                />
                                <span class="ms-1">days before the expiry date</span>
                            </div>
                            <div class="mt-2" invisible="not ppe_expiry_notice_days">
                                <label
                                    for="ppe_expiry_responsible_id"
                                    class="o_light_label me-2"
                                />
                                <field name="ppe_expiry_responsible_id" />
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
