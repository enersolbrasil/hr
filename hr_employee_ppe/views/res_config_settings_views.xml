<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form (in hr_employee_ppe)</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='hr']" position="inside">
                <block
                    title="Personal Protective Equipment"
                    name="ppe_setting_container"
                >
                    <setting
                        id="ppe_block_expired_certification_setting"
                        help="Do not deliver PPE whose certification has expired."
                    >
                        <field name="ppe_block_expired_certification" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
