<odoo>
    <record id="hr_employee_form_view" model="ir.ui.view">
        <field name="name">hr.employee.form (in hr_employee_ppe)</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="ppe" string="PPE" groups="hr.group_hr_user">
                    <field name="ppe_ids" readonly="1">
                        <list
                            decoration-info="state == 'accepted'"
                            decoration-success="state == 'valid'"
                            decoration-danger="state == 'expired'"
                        >
                            <field name="product_id" />
                            <field name="certification" />
                            <field name="quantity" />
                            <field name="start_date" />
                            <field name="expiry_date" />
                            <field
                                name="state"
                                widget="badge"
                                decoration-info="state == 'accepted'"
                                decoration-success="state == 'valid'"
                                decoration-danger="state == 'expired'"
                            />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
