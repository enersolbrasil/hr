<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- TREE -->
    <record id="hr_personal_equipment_tree_view" model="ir.ui.view">
        <field name="name">hr.personal.equipment.tree</field>
        <field name="model">hr.personal.equipment</field>
        <field
            name="inherit_id"
            ref="hr_personal_equipment_request.hr_personal_equipment_list_view"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='start_date']" position="after">
                <field name="expire_ppe" string="Expirable" />
                <field name="expiry_date" />
            </xpath>
        </field>
    </record>
    <!-- FORM -->
    <record id="hr_personal_equipment_form_view" model="ir.ui.view">
        <field name="name">hr.personal.equipment.form (in hr_employee_ppe)</field>
        <field name="model">hr.personal.equipment</field>
        <field
            name="inherit_id"
            ref="hr_personal_equipment_request.hr_personal_equipment_form_view"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field
                    name="is_ppe"
                    string="Is PPE"
                    readonly="1"
                    invisible="not is_ppe"
                />
            </xpath>
            <xpath expr="//field[@name='start_date']" position="before">
                <field
                    name="expire_ppe"
                    string="Expirable"
                    invisible="not is_ppe"
                    readonly="state not in ['draft','accepted']"
                />
            </xpath>
            <field name="expiry_date" position="attributes">
                <attribute
                    name="invisible"
                >state != 'expired' and (not expire_ppe)</attribute>
                <attribute name="readonly">state not in ['draft','accepted']</attribute>
            </field>
            <xpath expr="//group[@name='date']" position="after">
                <group
                    name="directions_info"
                    string="PPE Indications"
                    invisible="not is_ppe"
                >
                    <field name="indications" invisible="not is_ppe" readonly="1" />
                </group>
                <group string="Certification Information" invisible="not is_ppe">
                    <field name="issued_by" invisible="not is_ppe" readonly="1" />
                    <field
                        name="certification"
                        invisible="not is_ppe"
                        readonly="state not in ['draft','accepted']"
                    />
                </group>
                <group string="Employee Signature" invisible="not is_ppe">
                    <field name="employee_signature" widget="signature" readonly="state in ['expired', 'cancelled']" />
                    <field name="signed_on" readonly="1" invisible="not signed_on" />
                </group>
            </xpath>
        </field>
    </record>

    <record id="hr_personal_equipment_form_view_base_user" model="ir.ui.view">
        <field name="name">hr.personal.equipment.form (in hr_employee_ppe)</field>
        <field name="model">hr.personal.equipment</field>
        <field
            name="inherit_id"
            ref="hr_employee_ppe.hr_personal_equipment_form_view"
        />
        <field name="arch" type="xml">
            <field name="expire_ppe" position="attributes">
                <attribute name="readonly">True</attribute>
                <attribute name="groups">base.group_user</attribute>
            </field>
            <field name="start_date" position="attributes">
                <attribute name="readonly">True</attribute>
                <attribute name="groups">base.group_user</attribute>
            </field>
            <field name="expiry_date" position="attributes">
                <attribute name="readonly">True</attribute>
                <attribute name="groups">base.group_user</attribute>
            </field>
            <field name="certification" position="attributes">
                <attribute name="readonly">True</attribute>
                <attribute name="groups">base.group_user</attribute>
            </field>
        </field>
    </record>

    <!-- KANBAN -->
    <record id="hr_personal_equipment_kanban_view" model="ir.ui.view">
        <field name="name">hr.personal.equipment.kanban (in hr_employee_ppe)</field>
        <field name="model">hr.personal.equipment</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="state" />
                <field name="is_ppe" />
                <field name="expire_ppe" />
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <strong class="o_kanban_record_title"><field name="product_id" /></strong>
                            <span class="badge text-bg-light"><field name="quantity" /> un</span>
                        </div>
                        <div class="text-muted small mb-1">
                            <i class="fa fa-user me-1" /> <field name="employee_id" />
                        </div>
                        <div class="text-muted small mb-1" invisible="not certification">
                            <i class="fa fa-shield me-1" /> Cert.: <field name="certification" />
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-2 pt-1 border-top small">
                            <span>Delivery: <field name="start_date" /></span>
                            <span invisible="not expiry_date" class="text-end">
                                Exp.: <field name="expiry_date" />
                            </span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- EMPLOYEE FORM: Safety & PPE Tab -->
    <record id="hr_employee_form_view_ppe" model="ir.ui.view">
        <field name="name">hr.employee.form.ppe (in hr_employee_ppe)</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Safety &amp; PPE" name="ppe_management" groups="hr.group_hr_user">
                    <field name="personal_equipment_ids" readonly="1">
                        <list decoration-danger="state == 'expired'" decoration-warning="state == 'accepted'" decoration-success="state == 'valid'">
                            <field name="product_id" string="PPE / Equipment" />
                            <field name="certification" string="Certification No." />
                            <field name="quantity" string="Qty" />
                            <field name="start_date" string="Delivery Date" />
                            <field name="expiry_date" string="Expiry Date" />
                            <field name="state" widget="badge" decoration-danger="state == 'expired'" decoration-success="state == 'valid'" />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
